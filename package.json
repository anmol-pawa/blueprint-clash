{
  "name": "blueprint-clash",
  "version": "0.1.0",
  "private": true,
  "description": "Blueprint Clash: a creature-tactics RPG that teaches low-level design in C++ and system design",
  "scripts": {
    "predev": "node scripts/copy-clang.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-clang.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "prebuild:pages": "node scripts/copy-clang.mjs",
    "build:pages": "STATIC_EXPORT=1 BASE_PATH=${BASE_PATH-/blueprint-clash} next build && BASE_PATH=${BASE_PATH-/blueprint-clash} node scripts/gen-sw.mjs",
    "content:verify": "vitest run --config vitest.content.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@yowasp/clang": "^22.0.0-git20542-10",
    "codemirror": "^6.0.2",
    "next": "^16.2.10",
    "pixi.js": "^8.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
